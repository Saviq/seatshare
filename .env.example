APP_ENV=development
COOKIE_SECURE=false
GITHUB_CLIENT_ID=replace-with-your-development-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-your-development-oauth-client-secret
SESSION_SECRET=replace-with-a-random-secret-generated-as-described-in-the-readme
# Optional: defaults to http://$(hostname -f):8080 (https://$(hostname -f) with secure cookies)
# BASE_URL=http://localhost:8080
DB_PATH=.local/dev.db
